  "query_provenance": {
    "coverage": {
      "sql_file": "D:\\github-upload\\olist_channel_analysis_starter\\sql\\06_date_coverage.sql",
      "sha256": "2bfe110298700edbf2991ebf72b87a0d9fb0df6919bccf0ccffb40e4822c3e2a",
      "executed_sql": "-- 日期范围只表示文件内记录覆盖，不代表已知完整随访截止。\n-- 所有可见签约均纳入覆盖检查，包括日期冲突记录。\n\nSELECT\n    COUNT(*) AS lead_count,\n    SUM(has_observed_won) AS observed_won_count,\n    SUM(1 - has_observed_won) AS unmatched_won_count,\n    MIN(first_contact_date) AS first_contact_min,\n    MAX(first_contact_date) AS first_contact_max,\n    MIN(won_date) AS won_min,\n    MAX(won_date) AS won_max,\n    SUM(date_order_issue) AS date_issue_count,\n    SUM(CASE\n        WHEN DATE(won_date) > (SELECT MAX(first_contact_date) FROM mql)\n        THEN 1 ELSE 0\n    END) AS won_after_last_contact_date_count\nFROM lead_overview;",
      "row_count": 1,
      "result_sha256": "6e19db137ec57f416e1d998404608d3b2bac48d8f93ec8e05a8eae1a93072abf"
    },
    "won_months": {
      "sql_file": "D:\\github-upload\\olist_channel_analysis_starter\\sql\\06_won_months.sql",
      "sha256": "782e6b14268c817977b72fd661836e75db0e4fb267bf6158ef630a08592fb5bd",
      "executed_sql": "-- 这次按“签约发生月份”统计，含日期冲突原记录。\n-- 与04按“首次联系月份”分组的指标，含义不同。\n\nSELECT\n    SUBSTR(won_date, 1, 7) AS won_month,\n    COUNT(*) AS observed_won_count\nFROM lead_overview\nWHERE has_observed_won = 1\nGROUP BY SUBSTR(won_date, 1, 7)\nORDER BY won_month ASC;",
      "row_count": 12,
      "result_sha256": "a8c43898ed2a723a0182d558e50ae7f597aa9598f2939148547dd32f64facdbe"
    },
    "durations": {
      "sql_file": "D:\\github-upload\\olist_channel_analysis_starter\\sql\\06_won_calendar_days.sql",
      "sha256": "edbfaffc06270508f8a17ebbe6152378163d45d69ac72e7a439bb42d752847f2",
      "executed_sql": "-- 仅获取文件内匹配到签约的线索，不给未签约者补0天。\n-- DATE去掉时分秒；差值是日历天数，不是精确24小时耗时。\n-- 原记录全部保留，负值或无法解析日期的记录单独标记。\n\nSELECT\n    mql_id,\n    origin_group AS channel,\n    first_contact_date,\n    won_date,\n    CAST(JULIANDAY(DATE(won_date)) - JULIANDAY(DATE(first_contact_date)) AS INTEGER) AS calendar_days_to_won,\n    CASE\n        WHEN DATE(won_date) IS NULL OR DATE(first_contact_date) IS NULL THEN 'invalid_date'\n        WHEN DATE(won_date) < DATE(first_contact_date) THEN 'negative_interval'\n        ELSE 'valid_duration'\n    END AS duration_status\nFROM lead_overview\nWHERE has_observed_won = 1\nORDER BY mql_id;",
      "row_count": 842,
      "result_sha256": "c9b76bac122282c12d1803c1df66aa5d8761e739768825411bac037eff3a0051"
    }
  }
